# Debug variant (has busybox shell). Reported SEPARATELY, never used in the main measurements.
ARG NODE_VERSION=22.22.0
FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM gcr.io/distroless/nodejs22-debian12:debug-nonroot
ENV NODE_ENV=production APP_MODE=bench PORT=3000
WORKDIR /app
COPY --from=deps --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --chown=nonroot:nonroot package.json server.js ./
COPY --chown=nonroot:nonroot test-data/sample.txt /data/sample.txt
USER nonroot
EXPOSE 3000
CMD ["server.js"]
